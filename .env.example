# Application
VITE_APP_NAME=RenewalIQ
VITE_APP_VERSION=1.0.0
VITE_API_BASE_URL=http://localhost:3001/api

# Database (backend/API layer)
DATABASE_URL="postgresql://postgres:password@localhost:5432/renewaliq?schema=public"

# Auth (optional)
VITE_AUTH_ENABLED=false
JWT_SECRET=your-super-secret-jwt-key-here

# Feature Flags
VITE_ENABLE_FORECASTING=true
VITE_ENABLE_EXPORT=true
VITE_MAX_UPLOAD_SIZE_MB=50
